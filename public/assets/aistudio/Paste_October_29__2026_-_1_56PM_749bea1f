          <span className="text-amber">.</span>
        </a>

        {/* Desktop Links */}
        <nav className="hidden lg:flex items-center gap-6">
          {navLinks.map((link) => {
            const isActive = activeSection === link.href;
            return (
              <a
                key={link.name}
                href={link.href}
                className={`text-[10.5px] uppercase tracking-[0.12em] font-semibold transition-colors duration-200 ${
                  isActive ? 'text-amber' : 'text-ink-secondary hover:text-amber'
                }`}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        {/* Action Button & Mobile Toggle */}
        <div className="flex items-center gap-3">
          <a
            href={portfolioData.github}
            target="_blank"
            rel="noreferrer"
