### 9. `src/Component.tsx` (Tubes Interactive Background)

```tsx
import React, { useEffect, useRef, useState } from 'react';
import { randomColors } from './utils';

interface TubesBackgroundProps {
  children?: React.ReactNode;
  className?: string;
  enableClickInteraction?: boolean;
}

export function TubesBackground({ 
  children, 
  className,
  enableClickInteraction = true 
}: TubesBackgroundProps) {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [isLoaded, setIsLoaded] = useState(false);
  const tubesRef = useRef<any>(null);

  useEffect(() => {
    let mounted = true;
    let cleanup: (() => void) | undefined;

    const initTubes = async () => {
      if (!canvasRef.current) return;

      try {
        // @ts-ignore
        const module = await import('https://cdn.jsdelivr.net/npm/threejs-components@0.0.19/build/cursors/tubes1.min.js');
        const TubesCursor = module.default;

        if (!mounted) return;

        const app = TubesCursor(canvasRef.current, {
          tubes: {
            colors: ["#E8913C", "#2E6B72", "#EDE7DC"],
            lights: {
              intensity: 180,
              colors: ["#E8913C", "#2E6B72", "#ffffff", "#9EA5A8"]
            }
          }
        });

        tubesRef.current = app;
        setIsLoaded(true);

        const handleResize = () => {
          // Canvas auto-resizes via CSS, internal Three.js resize handled by library if listener attached
        };

        window.addEventListener('resize', handleResize);
        
        cleanup = () => {
          window.removeEventListener('resize', handleResize);
          try {
            app.destroy?.();
          } catch (e) {
            // ignore cleanup errors
          }
        };

      } catch (error) {
        console.error("Failed to load TubesCursor from CDN, falling back to gradient background:", error);
      }
    };

    initTubes();

    return () => {
      mounted = false;
      if (cleanup) cleanup();
    };
  }, []);

  const handleClick = (e: React.MouseEvent) => {
    // Prevent randomizing if clicking interactive elements (buttons, links, inputs)
    const target = e.target as HTMLElement;
    if (target.closest('button') || target.closest('a') || target.closest('input') || target.closest('textarea')) {
      return;
    }

    if (!enableClickInteraction || !tubesRef.current) return;
    
    const colors = randomColors(3);
    const lightsColors = randomColors(4);
    
    try {
      tubesRef.current.tubes.setColors(colors);
      tubesRef.current.tubes.setLightsColors(lightsColors);
    } catch (err) {
      // ignore
    }
  };

  return (
    <div 
      className={`relative w-full min-h-screen bg-ground overflow-x-hidden ${className || ''}`}
      onClick={handleClick}
    >
      {/* Fixed Background Canvas */}
      <canvas 
        ref={canvasRef} 
        className="fixed inset-0 w-full h-full -z-10 pointer-events-auto block"
        style={{ touchAction: 'none' }}
      />
      
      {/* Fallback gradient if canvas fails or during load */}
      <div className="fixed inset-0 -z-20 bg-gradient-to-br from-ground via-ground-secondary to-ground" />

      {/* Foreground Content Overlay */}
      <div className="relative z-10 w-full pointer-events-auto">
        {children}
      </div>
    </div>
  );
}

export default TubesBackground;

```

