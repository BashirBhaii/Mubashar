  { name: 'Skills', href: '#section-6' },
  { name: 'Certifications', href: '#section-7' },
  { name: 'Projects', href: '#section-8' },
  { name: 'Interests', href: '#section-9' },
];

export function Navbar() {
  const [isOpen, setIsOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [activeSection, setActiveSection] = useState('#section-1');

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 40);

      const sections = navLinks.map(link => document.querySelector(link.href));
      const scrollPosition = window.scrollY + 200;

      sections.forEach((sec, idx) => {
        if (sec) {
          const top = (sec as HTMLElement).offsetTop;
          const height = (sec as HTMLElement).offsetHeight;
          if (scrollPosition >= top && scrollPosition < top + height) {
            setActiveSection(navLinks[idx].href);
          }
        }
      });
    };

    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  return (
    <header className={`fixed top-0 left-0 right-0 z-50 h-[58px] transition-all duration-300 flex items-center border-b border-hairline ${
      scrolled ? 'bg-ground/85 backdrop-blur-md shadow-lg shadow-black/40' : 'bg-transparent'
